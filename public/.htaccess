<IfModule mod_php8.c>
    php_value upload_max_filesize -1
    php_value post_max_size -1
    php_value memory_limit -1
    php_value max_execution_time 0
    php_value max_input_time 0
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize -1
    php_value post_max_size -1
    php_value memory_limit -1
    php_value max_execution_time 0
    php_value max_input_time 0
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize -1
    php_value post_max_size -1
    php_value memory_limit -1
    php_value max_execution_time 0
    php_value max_input_time 0
</IfModule>
